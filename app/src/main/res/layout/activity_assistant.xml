<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@drawable/app_background"
    android:orientation="vertical"
    android:padding="16dp">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:background="@drawable/card_background"
        android:gravity="center_vertical"
        android:orientation="horizontal"
        android:padding="14dp">

        <Button
            android:id="@+id/assistantBack"
            android:layout_width="48dp"
            android:layout_height="48dp"
            android:background="@drawable/dark_button_background"
            android:contentDescription="@string/assistant_back"
            android:text="‹"
            android:textColor="@color/cyan"
            android:textSize="28sp" />

        <LinearLayout
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_marginStart="12dp"
            android:layout_weight="1"
            android:orientation="vertical">
            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:letterSpacing="0.12"
                android:text="@string/assistant_eyebrow"
                android:textColor="@color/cyan"
                android:textSize="11sp"
                android:textStyle="bold" />
            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="2dp"
                android:text="@string/assistant_title"
                android:textColor="@color/ink"
                android:textSize="21sp"
                android:textStyle="bold" />
        </LinearLayout>

    </LinearLayout>

    <TextView
        android:id="@+id/assistantStatus"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="10dp"
        android:background="@drawable/input_background"
        android:paddingHorizontal="12dp"
        android:paddingVertical="9dp"
        android:text="@string/assistant_status_checking"
        android:textColor="@color/cyan_soft"
        android:textSize="11sp"
        android:textStyle="bold" />

    <Button
        android:id="@+id/assistantDownloadButton"
        android:layout_width="match_parent"
        android:layout_height="48dp"
        android:layout_marginTop="8dp"
        android:background="@drawable/dark_button_background"
        android:text="@string/assistant_download_model"
        android:textAllCaps="false"
        android:textColor="@color/cyan_soft"
        android:visibility="gone" />

    <ScrollView
        android:id="@+id/assistantScroll"
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_marginTop="12dp"
        android:layout_weight="1"
        android:fillViewport="true">
        <LinearLayout
            android:id="@+id/assistantMessages"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:paddingBottom="12dp" />
    </ScrollView>

    <TextView
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginBottom="8dp"
        android:letterSpacing="0.08"
        android:text="@string/assistant_quick_title"
        android:textColor="@color/muted"
        android:textSize="10sp"
        android:textStyle="bold" />

    <HorizontalScrollView
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginBottom="10dp"
        android:scrollbars="none">
        <LinearLayout
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:orientation="horizontal">
            <Button
                android:id="@+id/suggestionCharacter"
                android:layout_width="wrap_content"
                android:layout_height="44dp"
                android:layout_marginEnd="8dp"
                android:background="@drawable/dark_button_background"
                android:text="@string/assistant_suggestion_character"
                android:textAllCaps="false"
                android:textColor="@color/cyan_soft"
                android:textSize="12sp" />
            <Button
                android:id="@+id/suggestionTeam"
                android:layout_width="wrap_content"
                android:layout_height="44dp"
                android:layout_marginEnd="8dp"
                android:background="@drawable/dark_button_background"
                android:text="@string/assistant_suggestion_team"
                android:textAllCaps="false"
                android:textColor="@color/cyan_soft"
                android:textSize="12sp" />
            <Button
                android:id="@+id/suggestionStory"
                android:layout_width="wrap_content"
                android:layout_height="44dp"
                android:background="@drawable/dark_button_background"
                android:text="@string/assistant_suggestion_story"
                android:textAllCaps="false"
                android:textColor="@color/cyan_soft"
                android:textSize="12sp" />
        </LinearLayout>
    </HorizontalScrollView>

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:gravity="center_vertical"
        android:orientation="horizontal">
        <EditText
            android:id="@+id/assistantInput"
            android:layout_width="0dp"
            android:layout_height="54dp"
            android:layout_marginEnd="8dp"
            android:layout_weight="1"
            android:background="@drawable/input_background"
            android:hint="@string/assistant_hint"
            android:importantForAutofill="no"
            android:imeOptions="actionSend"
            android:inputType="textCapSentences|textMultiLine"
            android:maxLines="3"
            android:paddingHorizontal="14dp"
            android:textColor="@color/ink"
            android:textColorHint="@color/muted"
            android:textSize="14sp" />
        <Button
            android:id="@+id/assistantSend"
            android:layout_width="64dp"
            android:layout_height="54dp"
            android:background="@drawable/red_button_background"
            android:contentDescription="@string/assistant_send"
            android:text="➤"
            android:textColor="@android:color/white"
            android:textSize="20sp" />
    </LinearLayout>

</LinearLayout>
