<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent" android:layout_height="wrap_content"
    android:layout_marginBottom="10dp" android:background="@drawable/card_background"
    android:gravity="center_vertical" android:orientation="horizontal" android:padding="12dp">
    <FrameLayout android:layout_width="82dp" android:layout_height="100dp"
        android:background="@drawable/image_background">
        <TextView android:id="@+id/characterInitials" android:layout_width="match_parent"
            android:layout_height="match_parent" android:gravity="center"
            android:textColor="@color/cyan" android:textSize="19sp" android:textStyle="bold" />
        <ImageView android:id="@+id/characterImage" android:layout_width="match_parent"
            android:layout_height="match_parent" android:scaleType="centerCrop"
            android:visibility="gone" />
    </FrameLayout>
    <LinearLayout android:layout_width="0dp" android:layout_height="wrap_content"
        android:layout_weight="1" android:orientation="vertical" android:paddingStart="12dp">
        <TextView android:id="@+id/characterName" android:layout_width="match_parent"
            android:layout_height="wrap_content" android:textColor="@color/ink"
            android:textSize="18sp" android:textStyle="bold" />
        <TextView android:id="@+id/characterRealName" android:layout_width="match_parent"
            android:layout_height="wrap_content" android:textColor="@color/muted"
            android:textSize="13sp" android:visibility="gone" />
        <TextView android:id="@+id/characterPublisher" android:layout_width="match_parent"
            android:layout_height="wrap_content" android:layout_marginTop="4dp"
            android:textColor="@color/cyan" android:textSize="11sp"
            android:textStyle="bold" android:visibility="gone" />
        <TextView android:id="@+id/characterSummary" android:layout_width="match_parent"
            android:layout_height="wrap_content" android:layout_marginTop="5dp"
            android:maxLines="3" android:textColor="@color/muted"
            android:textSize="13sp" android:visibility="gone" />
    </LinearLayout>
</LinearLayout>
